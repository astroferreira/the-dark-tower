    "DiseaseResistance": ["falls ill easily", "is rarely ill"],
    "AnalyticalAbility": ["finds reasoning hard", "has a keen mind"],
    "Focus": ["is easily distracted", "can hold their mind to a task for hours"],
    "Willpower": ["has a weak will", "has an iron will"],
    "Creativity": ["has no spark of invention", "is wildly inventive"],
    "Intuition": ["misreads what is coming", "has an uncanny sense of what is coming"],
    "Patience": ["has no patience at all", "is endlessly patient"],
    "Memory": ["forgets things quickly", "forgets nothing"],
    "LinguisticAbility": ["has trouble with words", "has a way with words"],
    "SpatialSense": ["gets lost easily", "has a sharp eye for distance and shape"],
    "Musicality": ["has a tin ear", "has a fine ear for music"],
    "KinestheticSense": ["is awkward with their hands", "has very sure hands"],
    "Empathy": ["cannot tell what others feel", "feels what others feel"],
    "SocialAwareness": ["misses every hint", "reads a room at a glance"]
  },

