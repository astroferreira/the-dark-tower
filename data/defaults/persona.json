    "HardWork": ["thinks hard work is for fools", "avoids hard work", "values hard work", "believes in nothing more than hard work"],
    "Sacrifice": ["thinks sacrifice is foolish", "sees little point in sacrifice", "values sacrifice", "would sacrifice anything for others"],
    "Competition": ["finds competition repugnant", "dislikes rivalry", "values competition", "lives to win"],
    "Perseverance": ["thinks persistence is foolish", "sees little use in persistence", "values perseverance", "holds endurance above all"],
    "Leisure": ["thinks leisure is shameful", "sees little point in rest", "values leisure", "lives for idle hours"],
    "Commerce": ["despises trade", "distrusts merchants", "values trade", "sees all life as a bargain"],
    "Romance": ["finds romance foolish", "has little use for romance", "values romance", "lives for love"],
    "Nature": ["sees nature as a thing to be mastered", "has little regard for the wild", "values the natural world", "holds the wild sacred"],
    "Peace": ["thinks war is glorious", "thinks war is sometimes needed", "values peace", "abhors war above all"],
