                 "LinguisticAbility", "SpatialSense", "Musicality", "KinestheticSense", "Empathy", "SocialAwareness"],

  "attribute_text": {
    "_comment": "[very low, high] phrases (the lowest and highest sixths of the race's range); low and ordinary say nothing.",
    "Strength": ["is very weak", "is mighty"],
    "Agility": ["is clumsy", "is very agile"],
    "Toughness": ["is fragile", "is very tough"],
    "Endurance": ["tires quickly", "is tireless"],
