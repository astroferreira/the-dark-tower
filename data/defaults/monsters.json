  "tweaks": {
    "_comment": "Structural tweaks: adjective, a 'with' phrase for the first sentence, a 'has' clause for the second.",
    "wings": {"adj": "winged", "with": "with great ragged wings", "has": "it has wings like a vast moth's", "flies": true},
    "tail": {"adj": "long-tailed", "with": "with a lashing tail", "has": "it has a long, whip-like tail"},
    "shell": {"adj": "shelled", "with": "with a heavy shell", "has": "it has a ridged shell across its back"},
    "trunk": {"adj": "trunked", "with": "with a long trunk", "has": "it has a short, grasping trunk"},
    "horns": {"adj": "horned", "with": "with curling horns", "has": "it has great curling horns"},
    "tusks": {"adj": "tusked", "with": "with yellowed tusks", "has": "it has tusks as long as a spear"},
    "spines": {"adj": "spined", "with": "covered in spines", "has": "its back bristles with spines"},
    "antennae": {"adj": "feathery", "with": "with long feathery antennae", "has": "it has long, sweeping antennae"},
    "mandibles": {"adj": "fanged", "with": "with snapping mandibles", "has": "it has great snapping mandibles"},
    "stinger": {"adj": "stinging", "with": "with a curved stinger", "has": "it carries a curved stinger"},
    "hood": {"adj": "hooded", "with": "with a broad hood", "has": "it spreads a broad, ribbed hood"},
    "tentacles": {"adj": "tentacled", "with": "with a mass of tentacles", "has": "it has a mass of writhing tentacles"},
    "crest": {"adj": "crested", "with": "with a tall crest", "has": "it has a tall, bright crest"}
  },

  "classes": {
    "_comment": "Body classes and the tweaks each allows second (adjective, 'has' clause, and a new word for its skin when the tweak changes it).",
    "mammal": {"skin": "fur", "blood": "blood", "tweaks": [["shaggy", "its fur hangs in long matted ropes"], ["bald", "it has no fur at all, only bare hide", "hide"], ["striped", "its fur is barred in stripes"]]},
    "chitin": {"skin": "chitin", "blood": "ichor", "tweaks": [["armoured", "its plates are thick as a shield"], ["glistening", "its plates glisten wetly"], ["pitted", "its shell is pitted and scarred"]]},
    "reptile": {"skin": "scales", "blood": "blood", "tweaks": [["scaly", "its scales overlap like roof tiles"], ["frilled", "it has a frill about its neck"], ["warty", "its hide is thick with warts"]]},
    "amphibian": {"skin": "slimy skin", "blood": "blood", "tweaks": [["slimy", "it is coated in slime"], ["bloated", "it has a bloated body"], ["translucent", "its skin is nearly clear"]]},
    "avian": {"skin": "feathers", "blood": "blood", "tweaks": [["plumed", "its feathers trail behind it"], ["bald-headed", "its head is bare and raw"], ["ragged", "its feathers are ragged and falling"]]},
    "feathered reptile": {"skin": "scales and feathers", "blood": "blood", "tweaks": [["feathered", "its scales give way to feathers"], ["crested", "it has a crest of feathers"]]},
    "fleshy": {"skin": "skin", "blood": "blood", "tweaks": [["lumpy", "its body is lumpy and uneven"], ["pallid", "its flesh is pale as a fish's"], ["sinewy", "every sinew shows under its skin"]]}
  },

