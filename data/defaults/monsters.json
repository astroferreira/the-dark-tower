    "insect": {"legs": 6, "allows": ["wings", "antennae", "mandibles", "stinger", "horns"]},
    "spider": {"legs": 8, "allows": ["mandibles", "stinger", "shell"]},
    "serpent": {"legs": 0, "allows": ["wings", "horns", "spines", "hood"]},
    "worm": {"legs": 0, "allows": ["mandibles", "spines", "tentacles"]},
    "humanoid": {"legs": 2, "allows": ["wings", "tail", "horns", "tusks", "trunk"]},
    "bird": {"legs": 2, "allows": ["tail", "horns", "crest"]},
    "blob": {"legs": 0, "allows": ["tentacles", "spines"]},
    "crustacean": {"legs": 8, "allows": ["antennae", "spines", "stinger"]},
    "lizard": {"legs": 4, "allows": ["wings", "tail", "horns", "spines", "shell", "crest"]}
  },

